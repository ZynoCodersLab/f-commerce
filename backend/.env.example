# Copy this file to .env and adjust the values for your machine.
# .env is gitignored and is the file the backend reads; this example is the
# tracked template that documents every variable.

NODE_ENV=development
PORT=4000
# Managed Postgres providers require TLS: keep their query parameter (for
# example ?sslmode=require) on the URL. The backend passes the URL to the
# connection pool unchanged, so a wrong TLS mode fails when the server starts.
DATABASE_URL=postgresql://postgres:local@localhost:5432/f-commerce
# Optional. Defaults to DATABASE_URL with a "-test" suffix, for example
# postgresql://postgres:local@localhost:5432/f-commerce-test, and is created on
# first test run. Set this to point tests at a dedicated server instead.
TEST_DATABASE_URL=
# Redis backs BullMQ background jobs. The backend defaults to
# redis://localhost:6379 when this is unset.
REDIS_URL=redis://:fcommerce@localhost:6379
JWT_SECRET=replace-with-a-long-development-secret
JWT_REFRESH_SECRET=replace-with-a-long-development-secret
# Access tokens expire after 15 minutes and refresh tokens after 7 days; the
# TTLs are fixed in code.
CORS_ORIGINS=http://localhost:3000
# Public origin of the web app. Invite links are built from it, so set it to
# the address people should open the invitation at.
APP_ORIGIN=http://localhost:3000
# Email delivery for staff invitations. Leave RESEND_API_KEY blank on a machine
# without email access: the worker then records each invitation as skipped, and
# the team screen still shows the invitation and the link. Both are required
# when NODE_ENV=production, in the backend and in the worker.
RESEND_API_KEY=
# The sender line invitations arrive from. Leave this blank in development and
# set a verified sender in production, for example
# "F Commerce <invites@yourdomain.com>". Production startup fails when it is
# missing, because Resend rejects the sandbox sender for real recipients.
EMAIL_FROM=
# Optional. Replies go to this address; when unset they go to the person who
# sent the invitation.
EMAIL_REPLY_TO=
# Test-only escape hatch for end-to-end suites that create many accounts from
# one IP. Ignored when NODE_ENV=production.
RATE_LIMIT_DISABLED=false
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

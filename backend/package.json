{
  "name": "@f-commerce/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=tsx-dev src/server.ts",
    "prebuild": "npm run build --workspace @f-commerce/contracts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build --workspace @f-commerce/contracts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev:worker": "tsx watch --conditions=tsx-dev src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@f-commerce/contracts": "*",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.5.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "resend": "^6.37.0",
    "uuid": "^11.0.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.12.14",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
